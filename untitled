
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ЧС7 — 3D Train Simulator</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;font-family:Arial,sans-serif;background:#87ceeb;color:white}
canvas{display:block}
#hud{
 position:fixed;top:15px;left:15px;z-index:5;
 background:#101820dd;padding:16px;border-radius:12px;
 border:1px solid #ffffff44;min-width:190px
}
#hud h2{margin:0 0 12px;color:#ffcc66}
#speed{font-size:28px;font-weight:bold}
#help{
 position:fixed;bottom:15px;left:15px;z-index:5;
 background:#101820dd;padding:12px;border-radius:10px;
 line-height:1.7
}
button{
 background:#ffcc66;color:#171717;border:0;border-radius:6px;
 padding:8px 12px;font-weight:bold;cursor:pointer;margin-top:7px
}
#camera{position:fixed;right:15px;top:15px;z-index:5}
</style>
</head>
<body>

<div id="hud">
<h2>🚆 ЧС7</h2>
<div>Швидкість</div>
<div id="speed">0 км/год</div>
<div id="power">Тяга: 0%</div>
<div id="brakes">Гальмо: вимкнено</div>
</div>

<button id="camera">Змінити камеру (C)</button>

<div id="help">
<b>Керування</b><br>
W / ↑ — додати тягу<br>
S / ↓ — зменшити тягу<br>
Пробіл — гальмувати<br>
C — змінити камеру<br>
<button onclick="resetTrain()">Перезапустити</button>
</div>

<script type="module">
import * as THREE from
'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

// СЦЕНА
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);
scene.fog = new THREE.Fog(0x87ceeb, 100, 650);

const camera = new THREE.PerspectiveCamera(
 65, innerWidth/innerHeight, 0.1, 1500
);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
document.body.appendChild(renderer.domElement);

// СВІТЛО
scene.add(new THREE.HemisphereLight(0xffffff,0x506040,2));

const sun = new THREE.DirectionalLight(0xffffff,3);
sun.position.set(-30,60,30);
sun.castShadow = true;
scene.add(sun);

// МАТЕРІАЛИ
function material(color, metalness=0, roughness=0.8){
 return new THREE.MeshStandardMaterial({
  color, metalness, roughness
 });
}

const red = material(0xa51e2d,0.2,0.4);
const cream = material(0xe8d8b5);
const dark = material(0x24292e,0.3);
const glass = new THREE.MeshStandardMaterial({
 color:0x23485e,metalness:0.4,roughness:0.2
});
const steel = material(0x858b90,0.8,0.3);
const wood = material(0x514032);
const grass = material(0x588447);

// ЗЕМЛЯ
const ground = new THREE.Mesh(
 new THREE.PlaneGeometry(2000,2000),grass
);
ground.rotation.x=-Math.PI/2;
ground.position.y=-0.65;
ground.receiveShadow=true;
scene.add(ground);

// КОЛІЯ
const track = new THREE.Group();
scene.add(track);

const ballast = new THREE.Mesh(
 new THREE.BoxGeometry(4,0.18,1800),
 material(0x69645e)
);
ballast.position.set(0,-0.48,-500);
track.add(ballast);

// Рейки
for(const x of [-1.05,1.05]){
 const rail=new THREE.Mesh(
  new THREE.BoxGeometry(0.13,0.12,1800),steel
 );
 rail.position.set(x,-0.3,-500);
 track.add(rail);
}

// Шпали
for(let z=-1400;z<400;z+=2.5){
 const sleeper=new THREE.Mesh(
  new THREE.BoxGeometry(3,0.15,0.35),wood
 );
 sleeper.position.set(0,-0.36,z);
 track.add(sleeper);
}

// ДАЛЕКІ ПАГОРБИ
for(let i=0;i<50;i++){
 const h=10+Math.random()*25;
 const hill=new THREE.Mesh(
  new THREE.ConeGeometry(15+Math.random()*25,h,7),
  material(i%2?0x668d58:0x769765)
 );
 hill.position.set(
  (Math.random()<0.5?-1:1)*(30+Math.random()*130),
  h/2-0.5,
  -1200+Math.random()*1600
 );
 scene.add(hill);
}

// ДЕРЕВА
for(let i=0;i<240;i++){
 const tree=new THREE.Group();
 const trunk=new THREE.Mesh(
  new THREE.CylinderGeometry(0.15,0.25,2,7),
  material(0x62442c)
 );
 trunk.position.y=0.4;
 tree.add(trunk);

 const crown=new THREE.Mesh(
  new THREE.ConeGeometry(1+Math.random(),3+Math.random()*3,7),
  material(i%2?0x285d35:0x397542)
 );
 crown.position.y=2.5;
 tree.add(crown);

 tree.position.set(
  (i%2?1:-1)*(7+Math.random()*55),
  -0.5,
  -1300+Math.random()*1700
 );
 scene.add(tree);
}

// КОНТАКТНА МЕРЕЖА
const poleMat=material(0x747b80,0.6,0.4);

for(let z=-1300;z<350;z+=35){
 for(const x of [-5.2,5.2]){
  const pole=new THREE.Mesh(
   new THREE.CylinderGeometry(0.07,0.12,8,8),
   poleMat
  );
  pole.position.set(x,3.3,z);
  scene.add(pole);
 }

 const wire=new THREE.Mesh(
  new THREE.BoxGeometry(10.5,0.035,0.035),steel
 );
 wire.position.set(0,6.6,z);
 scene.add(wire);
}

// ДОПОМІЖНА ФУНКЦІЯ ДЛЯ ДЕТАЛЕЙ
function addBox(parent,w,h,d,mat,x,y,z){
 const obj=new THREE.Mesh(
  new THREE.BoxGeometry(w,h,d),mat
 );
 obj.position.set(x,y,z);
 obj.castShadow=true;
 obj.receiveShadow=true;
 parent.add(obj);
 return obj;
}

// ЕЛЕКТРОВОЗ ЧС7
function createChS7(){
 const loco=new THREE.Group();

 // Основний корпус
 addBox(loco,3.15,2.1,10,red,0,1.5,0);
 addBox(loco,3.18,0.5,9.8,cream,0,1.55,0);
 addBox(loco,3.05,0.7,9.5,red,0,2.1,0);

 // Кабіни з обох кінців
 for(const end of [-1,1]){
  addBox(loco,3.05,1.4,1.1,red,0,2.2,end*4.45);
  addBox(loco,2.25,0.72,0.08,glass,0,2.7,end*5.02);

  // Передні фари
  for(const x of [-0.95,0.95]){
   const lamp=new THREE.Mesh(
    new THREE.CylinderGeometry(0.13,0.13,0.12,16),
    new THREE.MeshStandardMaterial({
     color:0xfff1bd,
     emissive:0xffbb33,
     emissiveIntensity:1.5
    })
   );
   lamp.rotation.x=Math.PI/2;
   lamp.position.set(x,1.55,end*5.08);
   loco.add(lamp);
  }
 }

 // Дах
 addBox(loco,2.2,0.2,7.5,dark,0,3.05,0);

 // Пантографи
 for(const z of [-2.2,2.2]){
  addBox(loco,0.12,0.8,0.12,dark,-0.55,3.5,z);
  addBox(loco,0.12,0.8,0.12,dark,0.55,3.5,z);
  addBox(loco,1.25,0.1,0.12,dark,0,3.9,z);
 }

 // Візки та колеса
 for(const z of [-3.4,-1.2,1.2,3.4]){
  addBox(loco,2.5,0.35,0.75,dark,0,0.55,z);

  for(const x of [-1.18,1.18]){
   const wheel=new THREE.Mesh(
    new THREE.CylinderGeometry(0.43,0.43,0.22,24),
    material(0x242424,0.7,0.3)
   );
   wheel.rotation.z=Math.PI/2;
   wheel.position.set(x,0.42,z);
   loco.add(wheel);
  }
 }

 // Бічні вентиляційні решітки
 for(const side of [-1,1]){
  for(let i=0;i<8;i++){
   addBox(
    loco,0.04,0.42,0.3,dark,
    side*1.59,1.95,-2.7+i*0.78
   );
  }
 }

 // Зчеплення
 addBox(loco,0.4,0.2,0.5,dark,0,0.6,5.25);

 scene.add(loco);
 return loco;
}

const train=createChS7();

// КЕРУВАННЯ
const keys={};
let speed=0;
let throttle=0;
let trainZ=0;
let cameraMode=0;
let braking=false;

addEventListener('keydown',e=>{
 const key=e.key.toLowerCase();
 keys[key]=true;

 if(['arrowup','arrowdown',' '].includes(key)){
  e.preventDefault();
 }

 if(key==='c'&&!e.repeat){
  cameraMode=(cameraMode+1)%3;
 }
});

addEventListener('keyup',e=>{
 keys[e.key.toLowerCase()]=false;
});

document.getElementById('camera').onclick=()=>{
 cameraMode=(cameraMode+1)%3;
};

window.resetTrain=function(){
 speed=0;
 throttle=0;
 trainZ=0;
 train.position.z=0;
};

// ФІЗИКА РУХУ
const clock=new THREE.Clock();

function animate(){
 requestAnimationFrame(animate);

 const dt=Math.min(clock.getDelta(),0.04);

 if(keys['w']||keys['arrowup']){
  throttle=Math.min(100,throttle+40*dt);
 }

 if(keys['s']||keys['arrowdown']){
  throttle=Math.max(0,throttle-55*dt);
 }

 braking=!!keys[' '];

 if(braking){
  speed=Math.max(0,speed-25*dt);
 }else{
  const acceleration=throttle/100*5.0;
  speed=Math.max(0,Math.min(160,
   speed+(acceleration-0.35)*dt
  ));
 }

 trainZ-=speed/3.6*dt;
 train.position.z=trainZ;

 // КАМЕРА
 if(cameraMode===0){
  // Зовнішня камера
  camera.position.set(8,6.5,trainZ+13);
  camera.lookAt(0,1.5,trainZ-5);
 }else if(cameraMode===1){
  // Вид спереду
  camera.position.set(0,3.2,trainZ+8.5);
  camera.lookAt(0,2,trainZ-15);
 }else{
  // Вид зверху
  camera.position.set(0,19,trainZ+4);
  camera.lookAt(0,0,trainZ-8);
 }

 document.getElementById('speed').textContent=
  Math.round(speed)+' км/год';

 document.getElementById('power').textContent=
  'Тяга: '+Math.round(throttle)+'%';

 document.getElementById('brakes').textContent=
  'Гальмо: '+(braking?'УВІМКНЕНО':'вимкнено');

 renderer.render(scene,camera);
}

animate();

// Зміна розміру вікна
addEventListener('resize',()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});
</script>
</body>
</html>
